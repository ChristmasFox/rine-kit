{
  "name": "rine-kit",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "RINE Open Core — shared Plugin SDK / Memory / PUBG packages (monorepo)",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --if-present test",
    "test:pg": "bash scripts/with-pgvector.sh pnpm --filter @rine-kit/agent-memory-postgres exec tsx --test \"tests/*.test.ts\"",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "pack:all": "node scripts/pack-all.mjs"
  }
}

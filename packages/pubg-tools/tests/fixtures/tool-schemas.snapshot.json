{
  "pubg_resolve_players": {
    "description": "Resolve configured PUBG players and aliases, or look up one exact official player name.",
    "input": {
      "type": "object",
      "properties": {
        "personIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "playerIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "playerNames": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "refresh": {
          "type": "boolean"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 256
        },
        "team": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "pubg_search_matches": {
    "description": "Search bounded PUBG matches and return a fresh resultSetId for follow-up facts or review. Not for 今日/昨日/本周战绩 record requests (use pubg_query_stats).",
    "input": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "maxLength": 128
        },
        "gameMode": {
          "type": "string",
          "maxLength": 64
        },
        "mapName": {
          "type": "string",
          "maxLength": 128
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "personIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "playerIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "playerNames": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "recentN": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "refresh": {
          "type": "boolean"
        },
        "selector": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "businessDayStart": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "timezone": {
                  "type": "string",
                  "maxLength": 128
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "enum": [
                    "time_range"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 128
                },
                "type": {
                  "enum": [
                    "relative_period"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sessionId": {
          "type": "string",
          "maxLength": 256
        },
        "sort": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "team": {
          "type": "boolean"
        },
        "timezone": {
          "type": "string",
          "maxLength": 128
        },
        "to": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "pubg_query_stats": {
    "description": "Query deterministic PUBG aggregates for a bounded selector and return validated presentation/displayText.",
    "input": {
      "type": "object",
      "properties": {
        "groupBy": {
          "enum": [
            "day",
            "map",
            "match",
            "mode",
            "player",
            "team"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "enum": [
              "assists",
              "avg_damage",
              "chicken_index",
              "damage",
              "dbnos",
              "deaths",
              "headshot_kills",
              "kd",
              "kills",
              "longest_kill",
              "matches",
              "performance_score",
              "rank",
              "revives",
              "survival_time",
              "top10",
              "wins"
            ]
          }
        },
        "operation": {
          "enum": [
            "detail",
            "list",
            "rank",
            "report",
            "strongest",
            "trend",
            "weakest"
          ]
        },
        "orderBy": {
          "type": "object",
          "properties": {
            "direction": {
              "enum": [
                "asc",
                "desc"
              ]
            },
            "metric": {
              "enum": [
                "assists",
                "avg_damage",
                "chicken_index",
                "damage",
                "dbnos",
                "deaths",
                "headshot_kills",
                "kd",
                "kills",
                "longest_kill",
                "matches",
                "performance_score",
                "rank",
                "revives",
                "survival_time",
                "top10",
                "wins"
              ]
            }
          },
          "required": [
            "direction",
            "metric"
          ],
          "additionalProperties": false
        },
        "personIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "playerIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "playerNames": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "refresh": {
          "type": "boolean"
        },
        "selector": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "businessDayStart": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "timezone": {
                  "type": "string",
                  "maxLength": 128
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "enum": [
                    "time_range"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "type": {
                  "enum": [
                    "last_n_matches"
                  ]
                }
              },
              "required": [
                "count",
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 128
                },
                "type": {
                  "enum": [
                    "relative_period"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "resultSetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "type": {
                  "enum": [
                    "result_set"
                  ]
                }
              },
              "required": [
                "resultSetId",
                "type"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sessionId": {
          "type": "string",
          "maxLength": 256
        },
        "team": {
          "type": "boolean"
        }
      },
      "required": [
        "metrics",
        "selector"
      ],
      "additionalProperties": false
    }
  },

{
  "name": "@rine-kit/pubg-sync",
  "version": "0.1.2",
  "type": "module",
  "description": "PUBG provider sync for @rine-kit/pubg-postgres: team sync worker, player-name resolver, shared API admission (rate limit), egress proxy config, worker metrics. Extracted from Gate; no KOOK dependency.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:pg": "bash ../../scripts/with-pgvector.sh npx tsx --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@rine-kit/pubg-domain": "workspace:*",
    "@rine-kit/pubg-intelligence": "workspace:*",
    "@rine-kit/pubg-postgres": "workspace:*",
    "pg": "^8.13.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ChristmasFox/rine-kit.git",
    "directory": "packages/pubg-sync"
  }
}

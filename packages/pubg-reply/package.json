{
  "name": "@rine-kit/pubg-reply",
  "version": "0.1.8",
  "type": "module",
  "description": "How a PUBG tool result reaches the model and the chat: the presentation glue (displayText in the chat layout, replyGuide, share link), the squad voice and roster, the PUBG rules text, the bare-record scope guard and the outbound evidence check. Moved unchanged from Lab's plugins/pubg and plugins/amadeus; hosts add only delivery.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@rine-kit/presentation": "workspace:*",
    "@rine-kit/pubg-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ChristmasFox/rine-kit.git",
    "directory": "packages/pubg-reply"
  }
}

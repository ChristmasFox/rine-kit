{
  "name": "@rine-kit/plugin-sdk",
  "version": "0.1.8",
  "type": "module",
  "description": "Contract for AI plugins: tools and prompt instructions a host can run for its own trusted users. No dependency on any host.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ChristmasFox/rine-kit.git",
    "directory": "packages/plugin-sdk"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
